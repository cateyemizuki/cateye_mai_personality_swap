# ============================================================
# 人格替换（cateye_mai_personality_swap）- .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.so
.venv/
venv/
env/
.python-version

# ── 运行时生成（Runner 按配置模型自动生成，不进仓库）─────────
config.toml

# ── 本机数据与日志（不进仓库）────────────────────────────────
data/
*.log

# ── 测试代码（只保留在开发工作区，不进仓库）──────────────────
test_*.py
*_test.py
test/
tests/
.pytest_cache/
.coverage

# ── maips/ 是用户脚本目录，整体进仓库（覆盖上面的排除规则）────
!maips/
!maips/**

# ── 环境与编辑器 ────────────────────────────────────────────
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── 个人隐私 / 本地专用（不进仓库）───────────────────────────
主人格.toml          # 主人格设定：个人隐私，仅在本地/数据目录
commit_template.txt  # 本地提交模板（本仓库约定不进 GitHub）
