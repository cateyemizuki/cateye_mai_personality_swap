# ============================================================
# 人格替换（cateye_mai_personality_swap）- .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.so
.venv/
venv/
env/
.python-version

# ── 运行时生成（Runner 按配置模型自动生成，不进仓库）─────────
config.toml

# ── 本机数据与日志（不进仓库）────────────────────────────────
data/
*.log

# ── 测试代码（只保留在开发工作区，不进仓库）──────────────────
test_*.py
*_test.py
test/
tests/
.pytest_cache/
.coverage

# ── maips/ 是用户脚本目录，整体进仓库（覆盖上面的排除规则）────
!maips/
!maips/**

# ── 环境与编辑器 ────────────────────────────────────────────
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── 个人隐私 / 本地专用（不进仓库）───────────────────────────
# 注意：gitignore 只把「行首 #」当注释，行尾跟注释会让整行变成无效模式，
#       因此本节的说明一律独立成行。
# 主人格设定：个人隐私，仅在本地/数据目录
主人格.toml
# 本地提交模板（本仓库约定不进 GitHub）
commit_template.txt
# 插件中心 Issue 提交文档（本地使用，不随插件上传）
ISSUE_SUBMISSION.md
# 上传发布操作手册（agent 用，从开发文档复制，不入仓库）
UPLOAD_AGENT.md
# 宿主安装回执与更新备份（发布安装模式写入，勿提交）
.maibot-release.json
.update_backups/
/config_back/

# ── 个人人格预设与个人脚本（不进仓库）─────────────────────────
# 插件根 preset/ 只保留 .gitkeep（交付暂存区，个人预设放本地/数据目录）
/preset/*.toml
!/preset/.gitkeep
# maips/ 随包示例进仓库（见上方 !maips/**），但个人路由脚本不上传
/maips/lezi_lock.py
/maips/priestess_swap.py

# ---- 追加自 MaiBot插件开发文档v1.3.0/.gitignore 模板（sync 2026-10-05）----
/config.toml
/data/
*.egg-info/
build/
dist/
.ruff_cache/
.mypy_cache/
htmlcov/
smoke_test*.py
/tests/
desktop.ini
