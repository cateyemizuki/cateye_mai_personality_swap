{
  "manifest_version": 2,
  "version": "1.4.7",
  "name": "夺舍麦麦",
  "description": "把当前人格设定保存为预设，按条件/概率/权重自动或手动切换各聊天流的人格；预设激活期间以覆盖式注入改写请求 system 中的官方人格/表达/行为段落（替换而非叠加），锚点未命中自动回退追加式，绝不误删官方内容。支持 maips 自定义脚本（与插件同信任级别）、切换状态持久化（重启不丢）、黑白名单与管理员鉴权。版本历史见 CHANGELOG.md。",
  "changelog": "CHANGELOG.md",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_mai_personality_swap"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.forward",
    "config.get",
    "chat.get_all_streams",
    "llm.generate",
    "message.get_recent",
    "message.build_readable"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "github.cateye.mai-personality-swap"
}
